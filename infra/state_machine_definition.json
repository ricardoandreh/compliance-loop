{
  "Comment": "MVP Compliance Automation Loop - MAPE-K State Machine",
  "StartAt": "InvokeAnalyze",
  "TimeoutSeconds": 300,
  "QueryLanguage": "JSONata",
  "States": {
    "InvokeAnalyze": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${analyze_lambda_arn}",
        "Payload": {
          "resource_arn": "{% $states.input.resource_arn %}",
          "resource_id": "{% $states.input.resource_id %}",
          "control_id": "{% $states.input.control_id %}",
          "account_id": "{% $states.input.account_id %}",
          "region": "{% $states.input.region %}",
          "event_time": "{% $states.input.event_time %}"
        }
      },
      "TimeoutSeconds": 15,
      "Output": {
        "resource_arn": "{% $states.input.resource_arn %}",
        "resource_id": "{% $states.input.resource_id %}",
        "control_id": "{% $states.input.control_id %}",
        "account_id": "{% $states.input.account_id %}",
        "region": "{% $states.input.region %}",
        "event_time": "{% $states.input.event_time %}",
        "analyze_result": {
          "state": "{% $states.result.Payload.state %}",
          "violation_id": "{% $states.result.Payload.violation_id %}",
          "exception_id": "{% $states.result.Payload.exception_id %}",
          "approved_by": "{% $states.result.Payload.approved_by %}",
          "timestamp": "{% $states.result.Payload.timestamp %}",
          "policy_version": "{% $states.result.Payload.policy_version %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Output": {
            "resource_arn": "{% $states.input.resource_arn %}",
            "resource_id": "{% $states.input.resource_id %}",
            "control_id": "{% $states.input.control_id %}",
            "account_id": "{% $states.input.account_id %}",
            "region": "{% $states.input.region %}",
            "error": "{% $states.errorOutput %}"
          },
          "Next": "AnalyzeFailedEscalation"
        }
      ],
      "Next": "ClassifyState"
    },
    "ClassifyState": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $states.input.analyze_result.state = 'S_nominal' %}",
          "Next": "RegisterNominal"
        },
        {
          "Condition": "{% $states.input.analyze_result.state = 'S_exception' %}",
          "Next": "RegisterException"
        },
        {
          "Condition": "{% $states.input.analyze_result.state = 'S_violation' %}",
          "Next": "InvokeExecute"
        }
      ],
      "Default": "UnknownStateEscalation"
    },
    "RegisterNominal": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Arguments": {
        "TableName": "${violations_log_table}",
        "Item": {
          "violation_id": {
            "S": "{% $states.input.analyze_result.violation_id %}"
          },
          "resource_arn": {
            "S": "{% $states.input.resource_arn %}"
          },
          "control_id": {
            "S": "{% $states.input.control_id %}"
          },
          "state": {
            "S": "S_nominal"
          },
          "timestamp": {
            "S": "{% $states.input.analyze_result.timestamp %}"
          },
          "policy_version": {
            "S": "{% $states.input.analyze_result.policy_version %}"
          },
          "account_id": {
            "S": "{% $states.input.account_id %}"
          },
          "region": {
            "S": "{% $states.input.region %}"
          }
        }
      },
      "End": true
    },
    "RegisterException": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Arguments": {
        "TableName": "${violations_log_table}",
        "Item": {
          "violation_id": {
            "S": "{% $states.input.analyze_result.violation_id %}"
          },
          "resource_arn": {
            "S": "{% $states.input.resource_arn %}"
          },
          "control_id": {
            "S": "{% $states.input.control_id %}"
          },
          "state": {
            "S": "S_exception"
          },
          "timestamp": {
            "S": "{% $states.input.analyze_result.timestamp %}"
          },
          "policy_version": {
            "S": "{% $states.input.analyze_result.policy_version %}"
          },
          "exception_id": {
            "S": "{% $states.input.analyze_result.exception_id ? $states.input.analyze_result.exception_id : '' %}"
          },
          "approved_by": {
            "S": "{% $states.input.analyze_result.approved_by ? $states.input.analyze_result.approved_by : '' %}"
          },
          "account_id": {
            "S": "{% $states.input.account_id %}"
          },
          "region": {
            "S": "{% $states.input.region %}"
          }
        }
      },
      "End": true
    },
    "InvokeExecute": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${execute_lambda_arn}",
        "Payload": {
          "resource_arn": "{% $states.input.resource_arn %}",
          "resource_id": "{% $states.input.resource_id %}",
          "control_id": "{% $states.input.control_id %}",
          "region": "{% $states.input.region %}",
          "violation_id": "{% $states.input.analyze_result.violation_id %}"
        }
      },
      "TimeoutSeconds": 90,
      "Output": {
        "resource_arn": "{% $states.input.resource_arn %}",
        "resource_id": "{% $states.input.resource_id %}",
        "control_id": "{% $states.input.control_id %}",
        "account_id": "{% $states.input.account_id %}",
        "region": "{% $states.input.region %}",
        "event_time": "{% $states.input.event_time %}",
        "analyze_result": "{% $states.input.analyze_result %}",
        "execute_result": {
          "remediation_status": "{% $states.result.Payload.remediation_status %}",
          "output": "{% $states.result.Payload.output ? $states.result.Payload.output : '' %}",
          "error": "{% $states.result.Payload.error ? $states.result.Payload.error : '' %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Output": {
            "resource_arn": "{% $states.input.resource_arn %}",
            "resource_id": "{% $states.input.resource_id %}",
            "control_id": "{% $states.input.control_id %}",
            "account_id": "{% $states.input.account_id %}",
            "region": "{% $states.input.region %}",
            "analyze_result": "{% $states.input.analyze_result %}",
            "execute_result": {
              "remediation_status": "failed",
              "error": "{% $states.errorOutput %}"
            }
          },
          "Next": "UpdateLogFailed"
        }
      ],
      "Next": "CheckRemediationStatus"
    },
    "CheckRemediationStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $states.input.execute_result.remediation_status = 'success' %}",
          "Next": "UpdateLogSuccess"
        },
        {
          "Condition": "{% $states.input.execute_result.remediation_status = 'failed' %}",
          "Next": "UpdateLogFailed"
        }
      ],
      "Default": "UpdateLogFailed"
    },
    "UpdateLogSuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${violations_log_table}",
        "Key": {
          "violation_id": {
            "S": "{% $states.input.analyze_result.violation_id %}"
          }
        },
        "UpdateExpression": "SET remediation_status = :status, remediation_timestamp = :ts, remediation_output = :output",
        "ExpressionAttributeValues": {
          ":status": {
            "S": "success"
          },
          ":ts": {
            "S": "{% $states.context.State.EnteredTime %}"
          },
          ":output": {
            "S": "{% $states.input.execute_result.output %}"
          }
        }
      },
      "End": true
    },
    "UpdateLogFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Arguments": {
        "TableName": "${violations_log_table}",
        "Key": {
          "violation_id": {
            "S": "{% $states.input.analyze_result.violation_id %}"
          }
        },
        "UpdateExpression": "SET remediation_status = :status, remediation_timestamp = :ts, remediation_error = :error",
        "ExpressionAttributeValues": {
          ":status": {
            "S": "failed"
          },
          ":ts": {
            "S": "{% $states.context.State.EnteredTime %}"
          },
          ":error": {
            "S": "{% $string($states.input.execute_result.error) %}"
          }
        }
      },
      "Output": {
        "resource_arn": "{% $states.input.resource_arn %}",
        "resource_id": "{% $states.input.resource_id %}",
        "control_id": "{% $states.input.control_id %}",
        "account_id": "{% $states.input.account_id %}",
        "region": "{% $states.input.region %}",
        "analyze_result": "{% $states.input.analyze_result %}",
        "execute_result": "{% $states.input.execute_result %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.RequestLimitExceeded"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Output": {
            "resource_arn": "{% $states.input.resource_arn %}",
            "resource_id": "{% $states.input.resource_id %}",
            "control_id": "{% $states.input.control_id %}",
            "account_id": "{% $states.input.account_id %}",
            "region": "{% $states.input.region %}",
            "analyze_result": "{% $states.input.analyze_result %}",
            "execute_result": "{% $states.input.execute_result %}"
          },
          "Next": "EnqueueEscalation"
        }
      ],
      "Next": "EnqueueEscalation"
    },
    "EnqueueEscalation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Arguments": {
        "QueueUrl": "${escalation_queue_url}",
        "MessageBody": "{% $string({'violation_id': $states.input.analyze_result.violation_id, 'resource_arn': $states.input.resource_arn, 'control_id': $states.input.control_id, 'error': $string($states.input.execute_result.error), 'timestamp': $states.context.State.EnteredTime, 'step_functions_execution_arn': $states.context.Execution.Id, 'account_id': $states.input.account_id, 'region': $states.input.region}) %}",
        "MessageGroupId": "{% $states.input.resource_id & '#' & $states.input.control_id %}",
        "MessageDeduplicationId": "{% $states.input.analyze_result.violation_id %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "SQS.SdkClientException",
            "SQS.ServiceException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "End": true
    },
    "AnalyzeFailedEscalation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Arguments": {
        "QueueUrl": "${escalation_queue_url}",
        "MessageBody": "{% $string({'violation_id': 'analyze-failed-' & $states.input.resource_id & '-' & $now(), 'resource_arn': $states.input.resource_arn, 'control_id': $states.input.control_id, 'error': 'Analyze Lambda failed: ' & $string($states.input.error), 'timestamp': $states.context.State.EnteredTime, 'step_functions_execution_arn': $states.context.Execution.Id, 'account_id': $states.input.account_id, 'region': $states.input.region}) %}",
        "MessageGroupId": "{% $states.input.resource_id & '#' & $states.input.control_id %}",
        "MessageDeduplicationId": "{% 'analyze-failed-' & $states.input.resource_id & '#' & $states.input.control_id %}"
      },
      "End": true
    },
    "UnknownStateEscalation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Arguments": {
        "QueueUrl": "${escalation_queue_url}",
        "MessageBody": "{% $string({'violation_id': $states.input.analyze_result.violation_id, 'resource_arn': $states.input.resource_arn, 'control_id': $states.input.control_id, 'error': 'Unknown state returned by Analyze: ' & $states.input.analyze_result.state, 'timestamp': $states.context.State.EnteredTime, 'step_functions_execution_arn': $states.context.Execution.Id, 'account_id': $states.input.account_id, 'region': $states.input.region}) %}",
        "MessageGroupId": "{% $states.input.resource_id & '#' & $states.input.control_id %}",
        "MessageDeduplicationId": "{% $states.input.analyze_result.violation_id %}"
      },
      "End": true
    }
  }
}
