{
  "Comment": "MAPE-K Compliance Loop — Single Analyze, Map over results. Timeout budget: the global timeout must cover the serial worst case, since ProcessResults runs with MaxConcurrency=1 — InvokeAnalyze (75s) + n_controls x (InvokeExecute 90s + writes ~5s). At the current 5 controls that is 550s, hence 600s. Raising the per-control Execute timeout, or adding controls that share a CloudTrail event, requires revisiting this.",
  "StartAt": "ResolveResource",
  "TimeoutSeconds": 600,
  "QueryLanguage": "JSONata",
  "States": {
    "ResolveResource": {
      "Type": "Pass",
      "Output": {
        "resource_id": "{% $states.input.request_parameters.bucketName ? $states.input.request_parameters.bucketName : ($states.input.response_elements.volumeId ? $states.input.response_elements.volumeId : ($states.input.resource_id ? $states.input.resource_id : 'account-level')) %}",
        "resource_arn": "{% $states.input.request_parameters.bucketName ? 'arn:aws:s3:::' & $states.input.request_parameters.bucketName : ($states.input.response_elements.volumeId ? 'arn:aws:ec2:' & $states.input.region & ':' & $states.input.account_id & ':volume/' & $states.input.response_elements.volumeId : ($states.input.resource_arn ? $states.input.resource_arn : 'arn:aws:' & $states.input.region & ':' & $states.input.account_id)) %}",
        "account_id": "{% $states.input.account_id %}",
        "region": "{% $states.input.region %}",
        "event_time": "{% $states.input.event_time %}",
        "event_name": "{% $states.input.event_name ? $states.input.event_name : '' %}",
        "control_id": "{% $states.input.control_id ? $states.input.control_id : '' %}",
        "mode": "{% $states.input.mode ? $states.input.mode : 'detect' %}",
        "origin_execution": "{% $states.input.origin_execution ? $states.input.origin_execution : '' %}",
        "origin_violations": "{% $states.input.origin_violations ? $states.input.origin_violations : {} %}",
        "controls": "{% $states.input.controls ? $states.input.controls : [] %}"
      },
      "Next": "RouteControlLookup"
    },
    "RouteControlLookup": {
      "Type": "Choice",
      "Comment": "Verification rounds (mode=verify) carry the controls to re-check → re-evaluate them straight away; a verification round without controls would re-evaluate nothing and succeed, so it escalates instead. Scheduler-triggered re-evaluation (TTL expiry / revocation / deletion) carries a control_id → re-check exactly that control. CloudTrail-triggered events carry neither → fan out by event_name.",
      "Choices": [
        {
          "Condition": "{% $states.input.mode = 'verify' and $count($states.input.controls) > 0 %}",
          "Next": "InvokeAnalyze"
        },
        {
          "Condition": "{% $states.input.mode = 'verify' %}",
          "Next": "UnverifiableRemediationEscalation"
        },
        {
          "Condition": "{% $states.input.control_id != '' %}",
          "Next": "GetControlById"
        }
      ],
      "Default": "QueryControls"
    },
    "GetControlById": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:getItem",
      "Arguments": {
        "TableName": "${controls_table}",
        "Key": {
          "control_id": {
            "S": "{% $states.input.control_id %}"
          }
        }
      },
      "Output": {
        "resource_arn": "{% $states.input.resource_arn %}",
        "resource_id": "{% $states.input.resource_id %}",
        "account_id": "{% $states.input.account_id %}",
        "region": "{% $states.input.region %}",
        "event_time": "{% $states.input.event_time %}",
        "event_name": "{% $states.input.event_name %}",
        "control_id": "{% $states.input.control_id %}",
        "controls": "{% $exists($states.result.Item) ? [$states.result.Item] : [] %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDb.ProvisionedThroughputExceededException",
            "DynamoDb.RequestLimitExceededException",
            "DynamoDb.InternalServerErrorException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0,
          "Comment": "aws-sdk integrations name errors DynamoDb.* (lowercase b); DynamoDB.* is the optimized integration's prefix and would never match here."
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": {
            "resource_arn": "{% $states.input.resource_arn %}",
            "resource_id": "{% $states.input.resource_id %}",
            "account_id": "{% $states.input.account_id %}",
            "region": "{% $states.input.region %}",
            "error": "{% $states.errorOutput %}"
          },
          "Next": "ControlLookupFailedEscalation"
        }
      ],
      "Next": "CheckRequestedControlFound"
    },
    "CheckRequestedControlFound": {
      "Type": "Choice",
      "Choices": [
        { "Condition": "{% $count($states.input.controls) > 0 %}", "Next": "InvokeAnalyze" }
      ],
      "Default": "RequestedControlNotFound"
    },
    "RequestedControlNotFound": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Arguments": {
        "QueueUrl": "${escalation_queue_url}",
        "MessageBody": "{% $string({'violation_id': 'control-not-found-' & $states.input.control_id & '-' & $states.input.resource_id, 'resource_arn': $states.input.resource_arn, 'control_id': $states.input.control_id, 'error': 'Requested control not found in controls table: ' & $states.input.control_id & ' (exception re-evaluation cannot proceed; control renamed or deleted with live exceptions?)', 'timestamp': $states.context.State.EnteredTime, 'step_functions_execution_arn': $states.context.Execution.Id, 'account_id': $states.input.account_id, 'region': $states.input.region}) %}",
        "MessageGroupId": "{% $states.input.resource_id & '#' & $states.input.control_id %}",
        "MessageDeduplicationId": "{% 'control-not-found-' & $states.input.control_id & '-' & $states.input.resource_id %}"
      },
      "Next": "ExecutionFailed",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Comment": "An alert that fails to enqueue is worth retrying whatever the cause; MessageDeduplicationId makes a retry idempotent, so this cannot double-escalate.",
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ]
    },
    "QueryControls": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:scan",
      "Arguments": {
        "TableName": "${controls_table}",
        "FilterExpression": "contains(cloudtrail_events, :evt)",
        "ExpressionAttributeValues": {
          ":evt": {
            "S": "{% $states.input.event_name %}"
          }
        }
      },
      "Output": {
        "resource_arn": "{% $states.input.resource_arn %}",
        "resource_id": "{% $states.input.resource_id %}",
        "account_id": "{% $states.input.account_id %}",
        "region": "{% $states.input.region %}",
        "event_time": "{% $states.input.event_time %}",
        "event_name": "{% $states.input.event_name %}",
        "controls": "{% $states.result.Items %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDb.ProvisionedThroughputExceededException",
            "DynamoDb.RequestLimitExceededException",
            "DynamoDb.InternalServerErrorException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0,
          "Comment": "aws-sdk integrations name errors DynamoDb.* (lowercase b); DynamoDB.* is the optimized integration's prefix and would never match here."
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": {
            "resource_arn": "{% $states.input.resource_arn %}",
            "resource_id": "{% $states.input.resource_id %}",
            "account_id": "{% $states.input.account_id %}",
            "region": "{% $states.input.region %}",
            "error": "{% $states.errorOutput %}"
          },
          "Next": "ControlLookupFailedEscalation"
        }
      ],
      "Next": "CheckControlsFound"
    },
    "CheckControlsFound": {
      "Type": "Choice",
      "Choices": [
        { "Condition": "{% $count($states.input.controls) > 0 %}", "Next": "InvokeAnalyze" }
      ],
      "Default": "ExecutionSucceeded"
    },
    "InvokeAnalyze": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${analyze_lambda_arn}",
        "Payload": {
          "resource_arn": "{% $states.input.resource_arn %}",
          "controls": "{% $states.input.controls %}",
          "account_id": "{% $states.input.account_id %}",
          "region": "{% $states.input.region %}",
          "event_time": "{% $states.input.event_time %}"
        }
      },
      "TimeoutSeconds": 75,
      "Output": {
        "resource_arn": "{% $states.input.resource_arn %}",
        "resource_id": "{% $states.input.resource_id %}",
        "account_id": "{% $states.input.account_id %}",
        "region": "{% $states.input.region %}",
        "event_time": "{% $states.input.event_time %}",
        "mode": "{% $states.input.mode ? $states.input.mode : 'detect' %}",
        "origin_execution": "{% $states.input.origin_execution ? $states.input.origin_execution : '' %}",
        "origin_violations": "{% $states.input.origin_violations ? $states.input.origin_violations : {} %}",
        "controls": "{% $states.input.controls %}",
        "results": "{% $states.result.Payload.results %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": {
            "resource_arn": "{% $states.input.resource_arn %}",
            "resource_id": "{% $states.input.resource_id %}",
            "account_id": "{% $states.input.account_id %}",
            "region": "{% $states.input.region %}",
            "error": "{% $states.errorOutput %}"
          },
          "Next": "AnalyzeFailedEscalation"
        }
      ],
      "Next": "ProcessResults"
    },
    "ProcessResults": {
      "Type": "Map",
      "MaxConcurrency": 1,
      "Items": "{% $states.input.results %}",
      "ItemSelector": {
        "resource_arn": "{% $states.input.resource_arn %}",
        "resource_id": "{% $states.input.resource_id %}",
        "account_id": "{% $states.input.account_id %}",
        "region": "{% $states.input.region %}",
        "event_time": "{% $states.input.event_time %}",
        "mode": "{% $states.input.mode %}",
        "origin_execution": "{% $states.input.origin_execution %}",
        "origin_violations": "{% $states.input.origin_violations %}",
        "analyze_result": "{% $states.context.Map.Item.Value %}"
      },
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "ClassifyState",
        "States": {
          "ClassifyState": {
            "Type": "Choice",
            "Comment": "The formal model has three states and nothing else. Whether this is a detection or a verification round does not change the state of the resource, only what the loop does about it, so mode is decided afterwards (PlanAction). A result without one of the three states is not a fourth state: the control could not be evaluated, which is a failure of the system, outside the model, and is escalated without being recorded as a state.",
            "Choices": [
              {
                "Condition": "{% $states.input.analyze_result.state = 'S_nominal' %}",
                "Next": "RegisterNominal"
              },
              {
                "Condition": "{% $states.input.analyze_result.state = 'S_exception' %}",
                "Next": "RegisterException"
              },
              {
                "Condition": "{% $states.input.analyze_result.state = 'S_violation' %}",
                "Next": "RegisterViolation"
              }
            ],
            "Default": "Escalate"
          },
          "RegisterNominal": {
            "Type": "Task",
            "Comment": "In a verification round this is the confirmation of convergence, linked to the violation it verifies (round, origin_execution, verifies_violation_id), so the audit trail reads violation -> remediation -> S_nominal as one chain.",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Arguments": {
              "TableName": "${violations_log_table}",
              "Item": "{% $merge([{'violation_id': {'S': $states.input.analyze_result.violation_id}, 'resource_arn': {'S': $states.input.resource_arn}, 'control_id': {'S': $states.input.analyze_result.control_id}, 'state': {'S': 'S_nominal'}, 'timestamp': {'S': $states.input.analyze_result.timestamp}, 'policy_version': {'S': $states.input.analyze_result.policy_version}, 'account_id': {'S': $states.input.account_id}, 'region': {'S': $states.input.region}}, $states.input.mode = 'verify' ? {'round': {'S': 'verification'}, 'origin_execution': {'S': $states.input.origin_execution}, 'verifies_violation_id': {'S': ($lookup($states.input.origin_violations, $states.input.analyze_result.control_id) ? $lookup($states.input.origin_violations, $states.input.analyze_result.control_id) : 'unknown')}} : {}]) %}"
            },
            "Output": {
              "outcome": "{% $states.input.mode = 'verify' ? 'verified' : 'nominal' %}",
              "control_id": "{% $states.input.analyze_result.control_id %}"
            },
            "End": true,
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.RequestLimitExceededException",
                  "DynamoDB.InternalServerErrorException"
                ],
                "Comment": "Transient only: a ConditionalCheckFailed or a validation error is a bug and must not be retried.",
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ]
          },
          "RegisterException": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Arguments": {
              "TableName": "${violations_log_table}",
              "Item": {
                "violation_id": {
                  "S": "{% $states.input.analyze_result.violation_id %}"
                },
                "resource_arn": {
                  "S": "{% $states.input.resource_arn %}"
                },
                "control_id": {
                  "S": "{% $states.input.analyze_result.control_id %}"
                },
                "state": {
                  "S": "S_exception"
                },
                "timestamp": {
                  "S": "{% $states.input.analyze_result.timestamp %}"
                },
                "policy_version": {
                  "S": "{% $states.input.analyze_result.policy_version %}"
                },
                "exception_id": {
                  "S": "{% $states.input.analyze_result.exception_id ? $states.input.analyze_result.exception_id : '' %}"
                },
                "approved_by": {
                  "S": "{% $states.input.analyze_result.approved_by ? $states.input.analyze_result.approved_by : '' %}"
                },
                "account_id": {
                  "S": "{% $states.input.account_id %}"
                },
                "region": {
                  "S": "{% $states.input.region %}"
                }
              }
            },
            "Output": {
              "outcome": "exception"
            },
            "End": true,
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.RequestLimitExceededException",
                  "DynamoDB.InternalServerErrorException"
                ],
                "Comment": "Transient only: a ConditionalCheckFailed or a validation error is a bug and must not be retried.",
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ]
          },
          "RegisterViolation": {
            "Type": "Task",
            "Comment": "In a verification round the violation is a non-convergence: a remediation reported success and the policy still fails, so the row carries the link to the violation it verifies and remediation_status=not_converged. Like every other write, no Retry/Catch (design.md, L1).",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Arguments": {
              "TableName": "${violations_log_table}",
              "Item": "{% $merge([{'violation_id': {'S': $states.input.analyze_result.violation_id}, 'resource_arn': {'S': $states.input.resource_arn}, 'control_id': {'S': $states.input.analyze_result.control_id}, 'state': {'S': 'S_violation'}, 'timestamp': {'S': $states.input.analyze_result.timestamp}, 'policy_version': {'S': $states.input.analyze_result.policy_version}, 'account_id': {'S': $states.input.account_id}, 'region': {'S': $states.input.region}}, $states.input.mode = 'verify' ? {'round': {'S': 'verification'}, 'origin_execution': {'S': $states.input.origin_execution}, 'verifies_violation_id': {'S': ($lookup($states.input.origin_violations, $states.input.analyze_result.control_id) ? $lookup($states.input.origin_violations, $states.input.analyze_result.control_id) : 'unknown')}, 'remediation_status': {'S': 'not_converged'}} : {}]) %}"
            },
            "Output": "{% $states.input %}",
            "Next": "CountRecentRemediations",
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.RequestLimitExceededException",
                  "DynamoDB.InternalServerErrorException"
                ],
                "Comment": "Transient only: a ConditionalCheckFailed or a validation error is a bug and must not be retried.",
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ]
          },
          "CountRecentRemediations": {
            "Type": "Task",
            "Comment": "The two rounds bound one incident; they say nothing about a sequence of them. An external process that keeps re-applying the violating configuration would be silently reverted forever, each incident 'converging'. This counts how many times this exact (resource, control) was remediated successfully in the last ${recurrence_window_minutes} minutes, and PlanAction escalates instead of remediating past the threshold — the Knowledge feeding back into Plan.",
            "Resource": "arn:aws:states:::aws-sdk:dynamodb:query",
            "Arguments": {
              "TableName": "${violations_log_table}",
              "IndexName": "resource_arn-timestamp-index",
              "KeyConditionExpression": "resource_arn = :arn AND #ts > :since",
              "FilterExpression": "control_id = :cid AND remediation_status = :ok",
              "ExpressionAttributeNames": {
                "#ts": "timestamp"
              },
              "ExpressionAttributeValues": {
                ":arn": {
                  "S": "{% $states.input.resource_arn %}"
                },
                ":since": {
                  "S": "{% $fromMillis($toMillis($states.context.State.EnteredTime) - ${recurrence_window_minutes} * 60000) %}"
                },
                ":cid": {
                  "S": "{% $states.input.analyze_result.control_id %}"
                },
                ":ok": {
                  "S": "success"
                }
              },
              "Select": "COUNT"
            },
            "Output": "{% $merge([$states.input, {'recent_remediations': $states.result.Count}]) %}",
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDb.ProvisionedThroughputExceededException",
                  "DynamoDb.RequestLimitExceededException",
                  "DynamoDb.InternalServerErrorException"
                ],
                "Comment": "aws-sdk integration: DynamoDb.* (lowercase b).",
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Comment": "Fail open: without the count the breaker cannot decide, and refusing to remediate on a failed query would turn a transient DynamoDB error into an unremediated violation.",
                "Output": "{% $merge([$states.input, {'recent_remediations': 0}]) %}",
                "Next": "PlanAction"
              }
            ],
            "Next": "PlanAction"
          },
          "PlanAction": {
            "Type": "Choice",
            "Comment": "Plan: what to do about S_violation. The verification rule comes first on purpose — in a verification round a violation escalates and never reaches InvokeExecute, which is what bounds an incident to two executions. The second rule is the circuit breaker: past ${recurrence_threshold} successful remediations of the same (resource, control) inside the window, remediating again would only keep a reversion war going, so it escalates as an ownership conflict.",
            "Choices": [
              {
                "Condition": "{% $states.input.mode = 'verify' %}",
                "Next": "Escalate"
              },
              {
                "Condition": "{% $states.input.recent_remediations >= ${recurrence_threshold} %}",
                "Next": "Escalate"
              },
              {
                "Condition": "{% $states.input.analyze_result.remediation = 'manual' %}",
                "Next": "Escalate"
              }
            ],
            "Default": "InvokeExecute"
          },
          "InvokeExecute": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Arguments": {
              "FunctionName": "${execute_lambda_arn}",
              "Payload": {
                "resource_arn": "{% $states.input.resource_arn %}",
                "resource_id": "{% $states.input.resource_id %}",
                "control_id": "{% $states.input.analyze_result.control_id %}",
                "region": "{% $states.input.region %}",
                "violation_id": "{% $states.input.analyze_result.violation_id %}",
                "remediation_s3_key": "{% $states.input.analyze_result.remediation_s3_key %}"
              }
            },
            "TimeoutSeconds": 90,
            "Output": {
              "resource_arn": "{% $states.input.resource_arn %}",
              "resource_id": "{% $states.input.resource_id %}",
              "control_id": "{% $states.input.analyze_result.control_id %}",
              "account_id": "{% $states.input.account_id %}",
              "region": "{% $states.input.region %}",
              "event_time": "{% $states.input.event_time %}",
              "analyze_result": "{% $states.input.analyze_result %}",
              "execute_result": {
                "remediation_status": "{% $states.result.Payload.remediation_status %}",
                "output": "{% $states.result.Payload.output ? $states.result.Payload.output : '' %}",
                "error": "{% $states.result.Payload.error ? $states.result.Payload.error : '' %}"
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 5,
                "MaxAttempts": 2,
                "BackoffRate": 2.0
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Output": {
                  "resource_arn": "{% $states.input.resource_arn %}",
                  "resource_id": "{% $states.input.resource_id %}",
                  "control_id": "{% $states.input.analyze_result.control_id %}",
                  "account_id": "{% $states.input.account_id %}",
                  "region": "{% $states.input.region %}",
                  "analyze_result": "{% $states.input.analyze_result %}",
                  "execute_result": {
                    "remediation_status": "failed",
                    "error": "{% $states.errorOutput %}"
                  }
                },
                "Next": "UpdateLogFailed"
              }
            ],
            "Next": "CheckRemediationStatus"
          },
          "CheckRemediationStatus": {
            "Type": "Choice",
            "Comment": "Anything but an explicit success is a failure: 'failed', a missing status or an unexpected value all escalate.",
            "Choices": [
              {
                "Condition": "{% $states.input.execute_result.remediation_status = 'success' %}",
                "Next": "UpdateLogSuccess"
              }
            ],
            "Default": "UpdateLogFailed"
          },
          "UpdateLogSuccess": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "Arguments": {
              "TableName": "${violations_log_table}",
              "Key": {
                "violation_id": {
                  "S": "{% $states.input.analyze_result.violation_id %}"
                }
              },
              "UpdateExpression": "SET remediation_status = :status, remediation_timestamp = :ts, remediation_output = :output",
              "ExpressionAttributeValues": {
                ":status": {
                  "S": "success"
                },
                ":ts": {
                  "S": "{% $states.context.State.EnteredTime %}"
                },
                ":output": {
                  "S": "{% $states.input.execute_result.output %}"
                }
              }
            },
            "Output": {
              "outcome": "remediated",
              "control_id": "{% $states.input.analyze_result.control_id %}",
              "violation_id": "{% $states.input.analyze_result.violation_id %}"
            },
            "End": true,
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.RequestLimitExceededException",
                  "DynamoDB.InternalServerErrorException"
                ],
                "Comment": "Transient only: a ConditionalCheckFailed or a validation error is a bug and must not be retried.",
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ]
          },
          "UpdateLogFailed": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "Arguments": {
              "TableName": "${violations_log_table}",
              "Key": {
                "violation_id": {
                  "S": "{% $states.input.analyze_result.violation_id %}"
                }
              },
              "UpdateExpression": "SET remediation_status = :status, remediation_timestamp = :ts, remediation_error = :error",
              "ExpressionAttributeValues": {
                ":status": {
                  "S": "failed"
                },
                ":ts": {
                  "S": "{% $states.context.State.EnteredTime %}"
                },
                ":error": {
                  "S": "{% $string($states.input.execute_result.error) %}"
                }
              }
            },
            "Output": {
              "resource_arn": "{% $states.input.resource_arn %}",
              "resource_id": "{% $states.input.resource_id %}",
              "control_id": "{% $states.input.analyze_result.control_id %}",
              "account_id": "{% $states.input.account_id %}",
              "region": "{% $states.input.region %}",
              "analyze_result": "{% $states.input.analyze_result %}",
              "execute_result": "{% $states.input.execute_result %}"
            },
            "Next": "Escalate",
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.RequestLimitExceededException",
                  "DynamoDB.InternalServerErrorException"
                ],
                "Comment": "Transient only: a ConditionalCheckFailed or a validation error is a bug and must not be retried.",
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ]
          },
          "Escalate": {
            "Type": "Task",
            "Comment": "One escalation, five reasons: remediation_failed (Execute failed), non_convergence (S_violation in a verification round), recurrent_violation (the same resource and control remediated ${recurrence_threshold} times inside the window — something keeps reverting it), manual_remediation_required (a detective control, whose fix is disruptive and belongs to a human) and system_failure (the control could not be evaluated — outside the state model, so there is no violations_log row and the escalation Lambda leaves the issue unlinked). Deduplication is by violation_id (unique per evaluation), NOT by resource+control: the FIFO 5-minute window would otherwise drop a second violation of the same pair, and that violation_id would never receive its github_issue_url, breaking the H2 audit chain. Duplicate ISSUES are prevented one layer up, in the escalation Lambda.",
            "Resource": "arn:aws:states:::sqs:sendMessage",
            "Arguments": {
              "QueueUrl": "${escalation_queue_url}",
              "MessageBody": "{% ( $reason := $states.input.execute_result ? 'remediation_failed' : ($states.input.analyze_result.state = 'S_violation' ? ($states.input.mode = 'verify' ? 'non_convergence' : ($states.input.analyze_result.remediation = 'manual' ? 'manual_remediation_required' : 'recurrent_violation')) : 'system_failure'); $error := $reason = 'remediation_failed' ? $string($states.input.execute_result.error) : ($reason = 'non_convergence' ? 'Remediation did not converge: the verification round still finds ' & $states.input.analyze_result.control_id & ' violated after a remediation reported success (origin execution ' & $states.input.origin_execution & '). The loop does not remediate twice; human review required.' : ($reason = 'recurrent_violation' ? 'Recurrent violation: ' & $states.input.analyze_result.control_id & ' on this resource was already remediated ' & $string($states.input.recent_remediations) & ' time(s) in the last ${recurrence_window_minutes} minutes. Something keeps reverting it, so remediation was not attempted; resolve the ownership conflict or register an exception.' : ($reason = 'manual_remediation_required' ? 'Detective control: ' & $states.input.analyze_result.control_id & ' has no automatic remediation because fixing it is disruptive. The resource stays as it is until a human acts.' : 'System failure: the control could not be evaluated, so no state was assigned. ' & ($states.input.analyze_result.error ? $states.input.analyze_result.error : 'unknown')))); $string({'violation_id': $states.input.analyze_result.violation_id, 'resource_arn': $states.input.resource_arn, 'control_id': $states.input.analyze_result.control_id, 'reason': $reason, 'error': $error, 'timestamp': $states.context.State.EnteredTime, 'step_functions_execution_arn': $states.context.Execution.Id, 'account_id': $states.input.account_id, 'region': $states.input.region}) ) %}",
              "MessageGroupId": "{% $states.input.resource_id & '#' & $states.input.analyze_result.control_id %}",
              "MessageDeduplicationId": "{% $states.input.analyze_result.violation_id %}"
            },
            "Output": {
              "outcome": "escalated"
            },
            "End": true,
            "Retry": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Comment": "An alert that fails to enqueue is worth retrying whatever the cause; MessageDeduplicationId makes a retry idempotent, so this cannot double-escalate.",
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ]
          }
        }
      },
      "Output": {
        "resource_arn": "{% $states.input.resource_arn %}",
        "resource_id": "{% $states.input.resource_id %}",
        "account_id": "{% $states.input.account_id %}",
        "region": "{% $states.input.region %}",
        "mode": "{% $states.input.mode %}",
        "controls": "{% $states.input.controls %}",
        "outcomes": "{% $states.result %}"
      },
      "Next": "ScheduleVerificationIfNeeded"
    },
    "ScheduleVerificationIfNeeded": {
      "Type": "Choice",
      "Comment": "A detection round that remediated schedules one verification round carrying every remediated control. If the controls it would carry do not match what was remediated, the verification could pass without checking some of them — so that escalates instead of scheduling a partial check.",
      "Choices": [
        {
          "Condition": "{% $not($states.input.mode = 'verify') and $count($states.input.outcomes[outcome = 'remediated']) > 0 and ( $ids := $states.input.outcomes[outcome = 'remediated'].control_id; $count($states.input.controls[control_id.S in $ids]) ) = $count($states.input.outcomes[outcome = 'remediated']) %}",
          "Next": "ScheduleVerification"
        },
        {
          "Condition": "{% $not($states.input.mode = 'verify') and $count($states.input.outcomes[outcome = 'remediated']) > 0 %}",
          "Next": "UnverifiableRemediationEscalation"
        }
      ],
      "Default": "EvaluateOutcome"
    },
    "ScheduleVerification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution",
      "Arguments": {
        "StateMachineArn": "{% $states.context.StateMachine.Id %}",
        "Input": {
          "mode": "verify",
          "trigger": "verification",
          "resource_arn": "{% $states.input.resource_arn %}",
          "resource_id": "{% $states.input.resource_id %}",
          "account_id": "{% $states.input.account_id %}",
          "region": "{% $states.input.region %}",
          "event_time": "{% $states.context.State.EnteredTime %}",
          "origin_execution": "{% $states.context.Execution.Id %}",
          "origin_violations": "{% $merge($states.input.outcomes[outcome = 'remediated'].{control_id: violation_id}) %}",
          "controls": "{% ( $ids := $states.input.outcomes[outcome = 'remediated'].control_id; [$states.input.controls[control_id.S in $ids]] ) %}"
        }
      },
      "Output": "{% $states.input %}",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Comment": "A remediation whose convergence can no longer be verified is a governance gap, not a success.",
          "Output": {
            "resource_arn": "{% $states.input.resource_arn %}",
            "resource_id": "{% $states.input.resource_id %}",
            "account_id": "{% $states.input.account_id %}",
            "region": "{% $states.input.region %}",
            "error": "{% $states.errorOutput %}"
          },
          "Next": "UnverifiableRemediationEscalation"
        }
      ],
      "Next": "EvaluateOutcome"
    },
    "UnverifiableRemediationEscalation": {
      "Type": "Task",
      "Comment": "Convergence cannot be verified: the verification round could not be started, would carry fewer controls than were remediated, or arrived without controls.",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Arguments": {
        "QueueUrl": "${escalation_queue_url}",
        "MessageBody": "{% $string({'violation_id': 'unverifiable-remediation-' & $states.context.Execution.Name, 'resource_arn': $states.input.resource_arn, 'control_id': 'remediated-controls', 'error': 'Remediation convergence cannot be verified: ' & ($states.input.error ? $string($states.input.error) : ($states.input.mode = 'verify' ? 'the verification round carries no controls to re-evaluate' : 'the controls to verify do not match the remediated controls')), 'timestamp': $states.context.State.EnteredTime, 'step_functions_execution_arn': $states.context.Execution.Id, 'account_id': $states.input.account_id, 'region': $states.input.region}) %}",
        "MessageGroupId": "{% $states.input.resource_id & '#verification' %}",
        "MessageDeduplicationId": "{% 'unverifiable-remediation-' & $states.context.Execution.Name %}"
      },
      "Next": "ExecutionFailed",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Comment": "An alert that fails to enqueue is worth retrying whatever the cause; MessageDeduplicationId makes a retry idempotent, so this cannot double-escalate.",
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ]
    },
    "EvaluateOutcome": {
      "Type": "Choice",
      "Choices": [
        { "Condition": "{% $count($states.input.outcomes[outcome = 'escalated']) > 0 %}", "Next": "ExecutionFailed" }
      ],
      "Default": "ExecutionSucceeded"
    },
    "AnalyzeFailedEscalation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Arguments": {
        "QueueUrl": "${escalation_queue_url}",
        "MessageBody": "{% $string({'violation_id': 'analyze-failed-' & $states.input.resource_id & '-' & $now(), 'resource_arn': $states.input.resource_arn, 'control_id': 'all', 'error': 'Analyze Lambda failed: ' & $string($states.input.error), 'timestamp': $states.context.State.EnteredTime, 'step_functions_execution_arn': $states.context.Execution.Id, 'account_id': $states.input.account_id, 'region': $states.input.region}) %}",
        "MessageGroupId": "{% $states.input.resource_id & '#analyze' %}",
        "MessageDeduplicationId": "{% 'analyze-failed-' & $states.input.resource_id & '-' & $now() %}"
      },
      "Next": "ExecutionFailed",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Comment": "An alert that fails to enqueue is worth retrying whatever the cause; MessageDeduplicationId makes a retry idempotent, so this cannot double-escalate.",
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ]
    },
    "ControlLookupFailedEscalation": {
      "Type": "Task",
      "Comment": "Covers both control lookups: the scan by event (QueryControls) and the lookup by id (GetControlById).",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Arguments": {
        "QueueUrl": "${escalation_queue_url}",
        "MessageBody": "{% $string({'violation_id': 'control-lookup-failed-' & $states.input.resource_id & '-' & $now(), 'resource_arn': $states.input.resource_arn, 'control_id': 'unknown', 'error': 'Control lookup failed: ' & $string($states.input.error), 'timestamp': $states.context.State.EnteredTime, 'step_functions_execution_arn': $states.context.Execution.Id, 'account_id': $states.input.account_id, 'region': $states.input.region}) %}",
        "MessageGroupId": "{% $states.input.resource_id & '#control-lookup' %}",
        "MessageDeduplicationId": "{% 'control-lookup-failed-' & $states.input.resource_id & '-' & $now() %}"
      },
      "Next": "ExecutionFailed",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Comment": "An alert that fails to enqueue is worth retrying whatever the cause; MessageDeduplicationId makes a retry idempotent, so this cannot double-escalate.",
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ]
    },
    "ExecutionSucceeded": {
      "Type": "Succeed"
    },
    "ExecutionFailed": {
      "Type": "Fail",
      "Error": "ComplianceEscalation",
      "Cause": "The execution escalated to a human; the escalation message carries the reason."
    }
  }
}
