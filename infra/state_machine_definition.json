{
  "Comment": "MAPE-K Compliance Loop — Single Analyze, Map over results. Timeout budget: the global timeout must cover the serial worst case, since ProcessResults runs with MaxConcurrency=1 — InvokeAnalyze (75s) + n_controls x (InvokeExecute 90s + writes ~5s). At the current 5 controls that is 550s, hence 600s. Raising the per-control Execute timeout, or adding controls that share a CloudTrail event, requires revisiting this.",
  "StartAt": "ResolveResource",
  "TimeoutSeconds": 600,
  "QueryLanguage": "JSONata",
  "States": {
    "ResolveResource": {
      "Type": "Pass",
      "Output": {
        "resource_id": "{% $states.input.request_parameters.bucketName ? $states.input.request_parameters.bucketName : ($states.input.resource_id ? $states.input.resource_id : 'account-level') %}",
        "resource_arn": "{% $states.input.request_parameters.bucketName ? 'arn:aws:s3:::' & $states.input.request_parameters.bucketName : ($states.input.resource_arn ? $states.input.resource_arn : 'arn:aws:' & $states.input.region & ':' & $states.input.account_id) %}",
        "account_id": "{% $states.input.account_id %}",
        "region": "{% $states.input.region %}",
        "event_time": "{% $states.input.event_time %}",
        "event_name": "{% $states.input.event_name ? $states.input.event_name : '' %}",
        "control_id": "{% $states.input.control_id ? $states.input.control_id : '' %}",
        "mode": "{% $states.input.mode ? $states.input.mode : 'detect' %}",
        "origin_execution": "{% $states.input.origin_execution ? $states.input.origin_execution : '' %}",
        "origin_violations": "{% $states.input.origin_violations ? $states.input.origin_violations : {} %}",
        "controls": "{% $states.input.controls ? $states.input.controls : [] %}"
      },
      "Next": "RouteControlLookup"
    },
    "RouteControlLookup": {
      "Type": "Choice",
      "Comment": "Verification rounds (mode=verify) carry the controls to re-check → wait for consistency, then re-evaluate. Scheduler-triggered re-evaluation (TTL expiry / revocation / deletion) carries a control_id → re-check exactly that control. CloudTrail-triggered events carry neither → fan out by event_name.",
      "Choices": [
        { "Condition": "{% $states.input.mode = 'verify' %}", "Next": "WaitForConsistency" },
        { "Condition": "{% $states.input.control_id != '' %}", "Next": "GetControlById" }
      ],
      "Default": "QueryControls"
    },
    "WaitForConsistency": {
      "Type": "Wait",
      "Comment": "Verification round. It re-checks exactly the controls the detection round remediated, using the control definitions that round carried over, so there is nothing to look up. S3 bucket configuration is eventually consistent: the CloudTrail echo this round replaces used to arrive several seconds after a remediation, which quietly gave the read time to settle. With the echo filtered out, that margin has to be explicit, or a stale read would escalate a remediation that actually worked.",
      "Seconds": 15,
      "Next": "InvokeAnalyze"
    },
    "GetControlById": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:getItem",
      "Arguments": {
        "TableName": "${controls_table}",
        "Key": { "control_id": { "S": "{% $states.input.control_id %}" } }
      },
      "Output": {
        "resource_arn": "{% $states.input.resource_arn %}",
        "resource_id": "{% $states.input.resource_id %}",
        "account_id": "{% $states.input.account_id %}",
        "region": "{% $states.input.region %}",
        "event_time": "{% $states.input.event_time %}",
        "event_name": "{% $states.input.event_name %}",
        "control_id": "{% $states.input.control_id %}",
        "controls": "{% $exists($states.result.Item) ? [$states.result.Item] : [] %}"
      },
      "Retry": [
        { "ErrorEquals": ["DynamoDB.ProvisionedThroughputExceededException"], "IntervalSeconds": 1, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Output": {
            "resource_arn": "{% $states.input.resource_arn %}",
            "resource_id": "{% $states.input.resource_id %}",
            "account_id": "{% $states.input.account_id %}",
            "region": "{% $states.input.region %}",
            "error": "{% $states.errorOutput %}"
          },
          "Next": "QueryControlsFailedEscalation"
        }
      ],
      "Next": "CheckRequestedControlFound"
    },
    "CheckRequestedControlFound": {
      "Type": "Choice",
      "Choices": [
        { "Condition": "{% $count($states.input.controls) > 0 %}", "Next": "InvokeAnalyze" }
      ],
      "Default": "RequestedControlNotFound"
    },
    "RequestedControlNotFound": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Arguments": {
        "QueueUrl": "${escalation_queue_url}",
        "MessageBody": "{% $string({'violation_id': 'control-not-found-' & $states.input.control_id & '-' & $states.input.resource_id, 'resource_arn': $states.input.resource_arn, 'control_id': $states.input.control_id, 'error': 'Requested control not found in controls table: ' & $states.input.control_id & ' (exception re-evaluation cannot proceed; control renamed or deleted with live exceptions?)', 'timestamp': $states.context.State.EnteredTime, 'step_functions_execution_arn': $states.context.Execution.Id, 'account_id': $states.input.account_id, 'region': $states.input.region}) %}",
        "MessageGroupId": "{% $states.input.resource_id & '#' & $states.input.control_id %}",
        "MessageDeduplicationId": "{% 'control-not-found-' & $states.input.control_id & '-' & $states.input.resource_id %}"
      },
      "Next": "ExecutionFailed"
    },
    "QueryControls": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:scan",
      "Arguments": {
        "TableName": "${controls_table}",
        "FilterExpression": "contains(cloudtrail_events, :evt)",
        "ExpressionAttributeValues": {
          ":evt": { "S": "{% $states.input.event_name %}" }
        }
      },
      "Output": {
        "resource_arn": "{% $states.input.resource_arn %}",
        "resource_id": "{% $states.input.resource_id %}",
        "account_id": "{% $states.input.account_id %}",
        "region": "{% $states.input.region %}",
        "event_time": "{% $states.input.event_time %}",
        "event_name": "{% $states.input.event_name %}",
        "controls": "{% $states.result.Items %}"
      },
      "Retry": [
        { "ErrorEquals": ["DynamoDB.ProvisionedThroughputExceededException"], "IntervalSeconds": 1, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Output": {
            "resource_arn": "{% $states.input.resource_arn %}",
            "resource_id": "{% $states.input.resource_id %}",
            "account_id": "{% $states.input.account_id %}",
            "region": "{% $states.input.region %}",
            "error": "{% $states.errorOutput %}"
          },
          "Next": "QueryControlsFailedEscalation"
        }
      ],
      "Next": "CheckControlsFound"
    },
    "CheckControlsFound": {
      "Type": "Choice",
      "Choices": [
        { "Condition": "{% $count($states.input.controls) > 0 %}", "Next": "InvokeAnalyze" }
      ],
      "Default": "ExecutionSucceeded"
    },
    "InvokeAnalyze": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${analyze_lambda_arn}",
        "Payload": {
          "resource_arn": "{% $states.input.resource_arn %}",
          "controls": "{% $states.input.controls %}",
          "account_id": "{% $states.input.account_id %}",
          "region": "{% $states.input.region %}",
          "event_time": "{% $states.input.event_time %}"
        }
      },
      "TimeoutSeconds": 75,
      "Output": {
        "resource_arn": "{% $states.input.resource_arn %}",
        "resource_id": "{% $states.input.resource_id %}",
        "account_id": "{% $states.input.account_id %}",
        "region": "{% $states.input.region %}",
        "event_time": "{% $states.input.event_time %}",
        "mode": "{% $states.input.mode ? $states.input.mode : 'detect' %}",
        "origin_execution": "{% $states.input.origin_execution ? $states.input.origin_execution : '' %}",
        "origin_violations": "{% $states.input.origin_violations ? $states.input.origin_violations : {} %}",
        "controls": "{% $states.input.controls %}",
        "results": "{% $states.result.Payload.results %}"
      },
      "Retry": [
        { "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Output": {
            "resource_arn": "{% $states.input.resource_arn %}",
            "resource_id": "{% $states.input.resource_id %}",
            "account_id": "{% $states.input.account_id %}",
            "region": "{% $states.input.region %}",
            "error": "{% $states.errorOutput %}"
          },
          "Next": "AnalyzeFailedEscalation"
        }
      ],
      "Next": "ProcessResults"
    },
    "ProcessResults": {
      "Type": "Map",
      "MaxConcurrency": 1,
      "Items": "{% $states.input.results %}",
      "ItemSelector": {
        "resource_arn": "{% $states.input.resource_arn %}",
        "resource_id": "{% $states.input.resource_id %}",
        "account_id": "{% $states.input.account_id %}",
        "region": "{% $states.input.region %}",
        "event_time": "{% $states.input.event_time %}",
        "mode": "{% $states.input.mode %}",
        "origin_execution": "{% $states.input.origin_execution %}",
        "origin_violations": "{% $states.input.origin_violations %}",
        "analyze_result": "{% $states.context.Map.Item.Value %}"
      },
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "ClassifyState",
        "States": {
          "ClassifyState": {
            "Type": "Choice",
            "Comment": "The verification branches come first on purpose: in a verification round a violation must escalate, never reach InvokeExecute. That is what bounds an incident to two executions.",
            "Choices": [
              { "Condition": "{% $states.input.mode = 'verify' and $states.input.analyze_result.state = 'S_nominal' %}", "Next": "RegisterVerified" },
              { "Condition": "{% $states.input.mode = 'verify' and $states.input.analyze_result.state = 'S_violation' %}", "Next": "RegisterNonConvergence" },
              { "Condition": "{% $states.input.analyze_result.state = 'S_nominal' %}", "Next": "RegisterNominal" },
              { "Condition": "{% $states.input.analyze_result.state = 'S_exception' %}", "Next": "RegisterException" },
              { "Condition": "{% $states.input.analyze_result.state = 'S_violation' %}", "Next": "RegisterViolation" }
            ],
            "Default": "RegisterError"
          },
          "RegisterVerified": {
            "Type": "Task",
            "Comment": "Convergence confirmed. Linked to the violation it verifies, so the audit trail reads violation -> remediation -> verified as one chain instead of rows joined only by resource and time.",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Arguments": {
              "TableName": "${violations_log_table}",
              "Item": {
                "violation_id": { "S": "{% $states.input.analyze_result.violation_id %}" },
                "resource_arn": { "S": "{% $states.input.resource_arn %}" },
                "control_id": { "S": "{% $states.input.analyze_result.control_id %}" },
                "state": { "S": "S_nominal" },
                "timestamp": { "S": "{% $states.input.analyze_result.timestamp %}" },
                "policy_version": { "S": "{% $states.input.analyze_result.policy_version %}" },
                "round": { "S": "verification" },
                "origin_execution": { "S": "{% $states.input.origin_execution %}" },
                "verifies_violation_id": { "S": "{% $lookup($states.input.origin_violations, $states.input.analyze_result.control_id) ? $lookup($states.input.origin_violations, $states.input.analyze_result.control_id) : 'unknown' %}" },
                "account_id": { "S": "{% $states.input.account_id %}" },
                "region": { "S": "{% $states.input.region %}" }
              }
            },
            "Output": { "outcome": "verified", "control_id": "{% $states.input.analyze_result.control_id %}" },
            "End": true
          },
          "RegisterNonConvergence": {
            "Type": "Task",
            "Comment": "A remediation reported success but the verification round still sees the violation: the policy and its remediation disagree, or something external undid the fix. Recorded, then escalated — never remediated again, which is what keeps the loop from oscillating (design.md, L11).",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Arguments": {
              "TableName": "${violations_log_table}",
              "Item": {
                "violation_id": { "S": "{% $states.input.analyze_result.violation_id %}" },
                "resource_arn": { "S": "{% $states.input.resource_arn %}" },
                "control_id": { "S": "{% $states.input.analyze_result.control_id %}" },
                "state": { "S": "S_violation" },
                "timestamp": { "S": "{% $states.input.analyze_result.timestamp %}" },
                "policy_version": { "S": "{% $states.input.analyze_result.policy_version %}" },
                "round": { "S": "verification" },
                "remediation_status": { "S": "not_converged" },
                "origin_execution": { "S": "{% $states.input.origin_execution %}" },
                "verifies_violation_id": { "S": "{% $lookup($states.input.origin_violations, $states.input.analyze_result.control_id) ? $lookup($states.input.origin_violations, $states.input.analyze_result.control_id) : 'unknown' %}" },
                "account_id": { "S": "{% $states.input.account_id %}" },
                "region": { "S": "{% $states.input.region %}" }
              }
            },
            "Output": "{% $states.input %}",
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "Comment": "The audit write must never suppress the alert.",
                "Output": "{% $states.input %}",
                "Next": "NonConvergenceEscalation"
              }
            ],
            "Next": "NonConvergenceEscalation"
          },
          "NonConvergenceEscalation": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sqs:sendMessage",
            "Arguments": {
              "QueueUrl": "${escalation_queue_url}",
              "MessageBody": "{% $string({'violation_id': $states.input.analyze_result.violation_id, 'resource_arn': $states.input.resource_arn, 'control_id': $states.input.analyze_result.control_id, 'error': 'Remediation did not converge: the verification round still finds ' & $states.input.analyze_result.control_id & ' violated after a remediation reported success (origin execution ' & $states.input.origin_execution & '). The loop does not remediate twice; human review required.', 'timestamp': $states.context.State.EnteredTime, 'step_functions_execution_arn': $states.context.Execution.Id, 'account_id': $states.input.account_id, 'region': $states.input.region}) %}",
              "MessageGroupId": "{% $states.input.resource_id & '#' & $states.input.analyze_result.control_id %}",
              "MessageDeduplicationId": "{% $states.input.analyze_result.violation_id %}"
            },
            "Output": { "outcome": "escalated" },
            "End": true
          },
          "RegisterError": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Arguments": {
              "TableName": "${violations_log_table}",
              "Item": {
                "violation_id": { "S": "{% $states.input.analyze_result.violation_id %}" },
                "resource_arn": { "S": "{% $states.input.resource_arn %}" },
                "control_id": { "S": "{% $states.input.analyze_result.control_id %}" },
                "state": { "S": "{% $states.input.analyze_result.state %}" },
                "timestamp": { "S": "{% $states.input.analyze_result.timestamp %}" },
                "policy_version": { "S": "{% $states.input.analyze_result.policy_version %}" },
                "error": { "S": "{% $states.input.analyze_result.error ? $states.input.analyze_result.error : 'unknown' %}" },
                "account_id": { "S": "{% $states.input.account_id %}" },
                "region": { "S": "{% $states.input.region %}" }
              }
            },
            "Output": "{% $states.input %}",
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "Comment": "The audit write must never suppress the alert: if putItem fails, still enqueue the escalation (the S_error row is lost, but the GitHub issue is raised).",
                "Output": "{% $states.input %}",
                "Next": "ControlErrorEscalation"
              }
            ],
            "Next": "ControlErrorEscalation"
          },
          "RegisterNominal": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Arguments": {
              "TableName": "${violations_log_table}",
              "Item": {
                "violation_id": { "S": "{% $states.input.analyze_result.violation_id %}" },
                "resource_arn": { "S": "{% $states.input.resource_arn %}" },
                "control_id": { "S": "{% $states.input.analyze_result.control_id %}" },
                "state": { "S": "S_nominal" },
                "timestamp": { "S": "{% $states.input.analyze_result.timestamp %}" },
                "policy_version": { "S": "{% $states.input.analyze_result.policy_version %}" },
                "account_id": { "S": "{% $states.input.account_id %}" },
                "region": { "S": "{% $states.input.region %}" }
              }
            },
            "Output": { "outcome": "nominal" },
            "End": true
          },
          "RegisterException": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Arguments": {
              "TableName": "${violations_log_table}",
              "Item": {
                "violation_id": { "S": "{% $states.input.analyze_result.violation_id %}" },
                "resource_arn": { "S": "{% $states.input.resource_arn %}" },
                "control_id": { "S": "{% $states.input.analyze_result.control_id %}" },
                "state": { "S": "S_exception" },
                "timestamp": { "S": "{% $states.input.analyze_result.timestamp %}" },
                "policy_version": { "S": "{% $states.input.analyze_result.policy_version %}" },
                "exception_id": { "S": "{% $states.input.analyze_result.exception_id ? $states.input.analyze_result.exception_id : '' %}" },
                "approved_by": { "S": "{% $states.input.analyze_result.approved_by ? $states.input.analyze_result.approved_by : '' %}" },
                "account_id": { "S": "{% $states.input.account_id %}" },
                "region": { "S": "{% $states.input.region %}" }
              }
            },
            "Output": { "outcome": "exception" },
            "End": true
          },
          "RegisterViolation": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Arguments": {
              "TableName": "${violations_log_table}",
              "Item": {
                "violation_id": { "S": "{% $states.input.analyze_result.violation_id %}" },
                "resource_arn": { "S": "{% $states.input.resource_arn %}" },
                "control_id": { "S": "{% $states.input.analyze_result.control_id %}" },
                "state": { "S": "S_violation" },
                "timestamp": { "S": "{% $states.input.analyze_result.timestamp %}" },
                "policy_version": { "S": "{% $states.input.analyze_result.policy_version %}" },
                "account_id": { "S": "{% $states.input.account_id %}" },
                "region": { "S": "{% $states.input.region %}" }
              }
            },
            "Output": "{% $states.input %}",
            "Next": "InvokeExecute"
          },
          "InvokeExecute": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Arguments": {
              "FunctionName": "${execute_lambda_arn}",
              "Payload": {
                "resource_arn": "{% $states.input.resource_arn %}",
                "resource_id": "{% $states.input.resource_id %}",
                "control_id": "{% $states.input.analyze_result.control_id %}",
                "region": "{% $states.input.region %}",
                "violation_id": "{% $states.input.analyze_result.violation_id %}",
                "remediation_s3_key": "{% $states.input.analyze_result.remediation_s3_key %}"
              }
            },
            "TimeoutSeconds": 90,
            "Output": {
              "resource_arn": "{% $states.input.resource_arn %}",
              "resource_id": "{% $states.input.resource_id %}",
              "control_id": "{% $states.input.analyze_result.control_id %}",
              "account_id": "{% $states.input.account_id %}",
              "region": "{% $states.input.region %}",
              "event_time": "{% $states.input.event_time %}",
              "analyze_result": "{% $states.input.analyze_result %}",
              "execute_result": {
                "remediation_status": "{% $states.result.Payload.remediation_status %}",
                "output": "{% $states.result.Payload.output ? $states.result.Payload.output : '' %}",
                "error": "{% $states.result.Payload.error ? $states.result.Payload.error : '' %}"
              }
            },
            "Retry": [
              { "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"], "IntervalSeconds": 5, "MaxAttempts": 2, "BackoffRate": 2.0 }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "Output": {
                  "resource_arn": "{% $states.input.resource_arn %}",
                  "resource_id": "{% $states.input.resource_id %}",
                  "control_id": "{% $states.input.analyze_result.control_id %}",
                  "account_id": "{% $states.input.account_id %}",
                  "region": "{% $states.input.region %}",
                  "analyze_result": "{% $states.input.analyze_result %}",
                  "execute_result": { "remediation_status": "failed", "error": "{% $states.errorOutput %}" }
                },
                "Next": "UpdateLogFailed"
              }
            ],
            "Next": "CheckRemediationStatus"
          },
          "CheckRemediationStatus": {
            "Type": "Choice",
            "Choices": [
              { "Condition": "{% $states.input.execute_result.remediation_status = 'success' %}", "Next": "UpdateLogSuccess" },
              { "Condition": "{% $states.input.execute_result.remediation_status = 'failed' %}", "Next": "UpdateLogFailed" }
            ],
            "Default": "UpdateLogFailed"
          },
          "UpdateLogSuccess": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "Arguments": {
              "TableName": "${violations_log_table}",
              "Key": { "violation_id": { "S": "{% $states.input.analyze_result.violation_id %}" } },
              "UpdateExpression": "SET remediation_status = :status, remediation_timestamp = :ts, remediation_output = :output",
              "ExpressionAttributeValues": {
                ":status": { "S": "success" },
                ":ts": { "S": "{% $states.context.State.EnteredTime %}" },
                ":output": { "S": "{% $states.input.execute_result.output %}" }
              }
            },
            "Output": {
              "outcome": "remediated",
              "control_id": "{% $states.input.analyze_result.control_id %}",
              "violation_id": "{% $states.input.analyze_result.violation_id %}"
            },
            "End": true
          },
          "UpdateLogFailed": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "Arguments": {
              "TableName": "${violations_log_table}",
              "Key": { "violation_id": { "S": "{% $states.input.analyze_result.violation_id %}" } },
              "UpdateExpression": "SET remediation_status = :status, remediation_timestamp = :ts, remediation_error = :error",
              "ExpressionAttributeValues": {
                ":status": { "S": "failed" },
                ":ts": { "S": "{% $states.context.State.EnteredTime %}" },
                ":error": { "S": "{% $string($states.input.execute_result.error) %}" }
              }
            },
            "Output": {
              "resource_arn": "{% $states.input.resource_arn %}",
              "resource_id": "{% $states.input.resource_id %}",
              "control_id": "{% $states.input.analyze_result.control_id %}",
              "account_id": "{% $states.input.account_id %}",
              "region": "{% $states.input.region %}",
              "analyze_result": "{% $states.input.analyze_result %}",
              "execute_result": "{% $states.input.execute_result %}"
            },
            "Next": "EnqueueEscalation"
          },
          "EnqueueEscalation": {
            "Type": "Task",
            "Comment": "Deduplication is by violation_id (unique per evaluation), NOT by resource+control: the FIFO 5-minute window would otherwise drop a second violation of the same pair, and that violation_id would never receive its github_issue_url, breaking the H2 audit chain. Duplicate ISSUES are prevented one layer up, by find_open_issue() in the escalation Lambda, which is where semantic deduplication belongs.",
            "Resource": "arn:aws:states:::sqs:sendMessage",
            "Arguments": {
              "QueueUrl": "${escalation_queue_url}",
              "MessageBody": "{% $string({'violation_id': $states.input.analyze_result.violation_id, 'resource_arn': $states.input.resource_arn, 'control_id': $states.input.analyze_result.control_id, 'error': $string($states.input.execute_result.error), 'timestamp': $states.context.State.EnteredTime, 'step_functions_execution_arn': $states.context.Execution.Id, 'account_id': $states.input.account_id, 'region': $states.input.region}) %}",
              "MessageGroupId": "{% $states.input.resource_id & '#' & $states.input.analyze_result.control_id %}",
              "MessageDeduplicationId": "{% $states.input.analyze_result.violation_id %}"
            },
            "Output": { "outcome": "escalated" },
            "End": true
          },
          "ControlErrorEscalation": {
            "Type": "Task",
            "Comment": "Deduplication is by violation_id (unique per evaluation), NOT by resource+control: the FIFO 5-minute window would otherwise drop a second violation of the same pair, and that violation_id would never receive its github_issue_url, breaking the H2 audit chain. Duplicate ISSUES are prevented one layer up, by find_open_issue() in the escalation Lambda, which is where semantic deduplication belongs.",
            "Resource": "arn:aws:states:::sqs:sendMessage",
            "Arguments": {
              "QueueUrl": "${escalation_queue_url}",
              "MessageBody": "{% $string({'violation_id': $states.input.analyze_result.violation_id, 'resource_arn': $states.input.resource_arn, 'control_id': $states.input.analyze_result.control_id, 'error': 'Analyze returned: ' & $states.input.analyze_result.state & ' - ' & ($states.input.analyze_result.error ? $states.input.analyze_result.error : 'unknown'), 'timestamp': $states.context.State.EnteredTime, 'step_functions_execution_arn': $states.context.Execution.Id, 'account_id': $states.input.account_id, 'region': $states.input.region}) %}",
              "MessageGroupId": "{% $states.input.resource_id & '#' & $states.input.analyze_result.control_id %}",
              "MessageDeduplicationId": "{% $states.input.analyze_result.violation_id %}"
            },
            "Output": { "outcome": "escalated" },
            "End": true
          }
        }
      },
      "Output": {
        "resource_arn": "{% $states.input.resource_arn %}",
        "resource_id": "{% $states.input.resource_id %}",
        "account_id": "{% $states.input.account_id %}",
        "region": "{% $states.input.region %}",
        "mode": "{% $states.input.mode %}",
        "controls": "{% $states.input.controls %}",
        "outcomes": "{% $states.result %}"
      },
      "Next": "ScheduleVerificationIfNeeded"
    },
    "ScheduleVerificationIfNeeded": {
      "Type": "Choice",
      "Comment": "Close the MAPE-K loop with exactly one more round. Only a detection round that remediated something schedules it, and a verification round never does, so an incident costs at most two executions and cannot oscillate. The remediation's own CloudTrail events no longer start executions: the EventBridge rule filters out the Execute role.",
      "Choices": [
        { "Condition": "{% $not($states.input.mode = 'verify') and $count($states.input.outcomes[outcome = 'remediated']) > 0 %}", "Next": "ScheduleVerification" }
      ],
      "Default": "EvaluateOutcome"
    },
    "ScheduleVerification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution",
      "Arguments": {
        "StateMachineArn": "{% $states.context.StateMachine.Id %}",
        "Input": {
          "mode": "verify",
          "trigger": "verification",
          "resource_arn": "{% $states.input.resource_arn %}",
          "resource_id": "{% $states.input.resource_id %}",
          "account_id": "{% $states.input.account_id %}",
          "region": "{% $states.input.region %}",
          "event_time": "{% $states.context.State.EnteredTime %}",
          "origin_execution": "{% $states.context.Execution.Id %}",
          "origin_violations": "{% $merge($states.input.outcomes[outcome = 'remediated'].{control_id: violation_id}) %}",
          "controls": "{% ( $ids := $states.input.outcomes[outcome = 'remediated'].control_id; [$states.input.controls[control_id.S in $ids]] ) %}"
        }
      },
      "Output": "{% $states.input %}",
      "Retry": [
        { "ErrorEquals": ["States.TaskFailed"], "IntervalSeconds": 1, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Comment": "A remediation whose convergence can no longer be verified is a governance gap, not a success.",
          "Output": {
            "resource_arn": "{% $states.input.resource_arn %}",
            "resource_id": "{% $states.input.resource_id %}",
            "account_id": "{% $states.input.account_id %}",
            "region": "{% $states.input.region %}",
            "error": "{% $states.errorOutput %}"
          },
          "Next": "VerificationNotScheduledEscalation"
        }
      ],
      "Next": "EvaluateOutcome"
    },
    "VerificationNotScheduledEscalation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Arguments": {
        "QueueUrl": "${escalation_queue_url}",
        "MessageBody": "{% $string({'violation_id': 'verification-not-scheduled-' & $states.context.Execution.Name, 'resource_arn': $states.input.resource_arn, 'control_id': 'remediated-controls', 'error': 'Remediation succeeded but the verification round could not be scheduled; convergence is unverified: ' & $string($states.input.error), 'timestamp': $states.context.State.EnteredTime, 'step_functions_execution_arn': $states.context.Execution.Id, 'account_id': $states.input.account_id, 'region': $states.input.region}) %}",
        "MessageGroupId": "{% $states.input.resource_id & '#verification' %}",
        "MessageDeduplicationId": "{% 'verification-not-scheduled-' & $states.context.Execution.Name %}"
      },
      "Next": "ExecutionFailed"
    },
    "EvaluateOutcome": {
      "Type": "Choice",
      "Choices": [
        { "Condition": "{% $count($states.input.outcomes[outcome = 'escalated']) > 0 %}", "Next": "ExecutionFailed" }
      ],
      "Default": "ExecutionSucceeded"
    },
    "AnalyzeFailedEscalation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Arguments": {
        "QueueUrl": "${escalation_queue_url}",
        "MessageBody": "{% $string({'violation_id': 'analyze-failed-' & $states.input.resource_id & '-' & $now(), 'resource_arn': $states.input.resource_arn, 'control_id': 'all', 'error': 'Analyze Lambda failed: ' & $string($states.input.error), 'timestamp': $states.context.State.EnteredTime, 'step_functions_execution_arn': $states.context.Execution.Id, 'account_id': $states.input.account_id, 'region': $states.input.region}) %}",
        "MessageGroupId": "{% $states.input.resource_id & '#analyze' %}",
        "MessageDeduplicationId": "{% 'analyze-failed-' & $states.input.resource_id & '-' & $now() %}"
      },
      "Next": "ExecutionFailed"
    },
    "QueryControlsFailedEscalation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Arguments": {
        "QueueUrl": "${escalation_queue_url}",
        "MessageBody": "{% $string({'violation_id': 'query-controls-failed-' & $states.input.resource_id & '-' & $now(), 'resource_arn': $states.input.resource_arn, 'control_id': 'unknown', 'error': 'QueryControls failed: ' & $string($states.input.error), 'timestamp': $states.context.State.EnteredTime, 'step_functions_execution_arn': $states.context.Execution.Id, 'account_id': $states.input.account_id, 'region': $states.input.region}) %}",
        "MessageGroupId": "{% $states.input.resource_id & '#query-controls' %}",
        "MessageDeduplicationId": "{% 'query-controls-failed-' & $states.input.resource_id & '-' & $now() %}"
      },
      "Next": "ExecutionFailed"
    },
    "ExecutionSucceeded": {
      "Type": "Succeed"
    },
    "ExecutionFailed": {
      "Type": "Fail",
      "Error": "ComplianceEscalation",
      "Cause": "One or more controls required escalation"
    }
  }
}
