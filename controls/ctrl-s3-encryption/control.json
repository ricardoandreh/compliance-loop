{
  "control_id": {
    "S": "ctrl-s3-encryption"
  },
  "description": {
    "S": "S3 bucket must have server-side encryption enabled"
  },
  "cloudtrail_events": {
    "SS": [
      "CreateBucket",
      "PutBucketEncryption",
      "DeleteBucketEncryption"
    ]
  },
  "rego_policy_package": {
    "S": "s3_encryption"
  },
  "rego_s3_key": {
    "S": "controls/ctrl-s3-encryption/policy.rego"
  },
  "remediation_s3_key": {
    "S": "controls/ctrl-s3-encryption/remediation.tf"
  },
  "resource_type": {
    "S": "aws_s3_bucket"
  },
  "severity": {
    "S": "HIGH"
  },
  "nist_sp800_53": {
    "SS": [
      "SC-28"
    ]
  },
  "iso_iec_27002": {
    "SS": [
      "8.24"
    ]
  },
  "policy_version": {
    "S": "v1.1"
  },
  "fetch_config": {
    "M": {
      "service": {
        "S": "s3"
      },
      "method": {
        "S": "get_bucket_encryption"
      },
      "params": {
        "M": {
          "Bucket": {
            "S": "{resource_id}"
          }
        }
      },
      "result_path": {
        "S": "ServerSideEncryptionConfiguration"
      },
      "error_defaults": {
        "M": {
          "ServerSideEncryptionConfigurationNotFoundError": {
            "M": {
              "Rules": {
                "L": []
              }
            }
          }
        }
      }
    }
  },
  "remediation_actions": {
    "L": [
      {
        "S": "s3:PutEncryptionConfiguration"
      },
      {
        "S": "s3:GetEncryptionConfiguration"
      }
    ]
  },
  "remediation_scope": {
    "S": "resource"
  }
}
